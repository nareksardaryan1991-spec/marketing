{
  "expo": {
    "name": "Marketing",
    "slug": "marketing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nareksardaryan.marketing",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "ru"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешите доступ к микрофону, чтобы отправлять голосовые сообщения в чатах."
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-release-signing"
    ],
    "scheme": "marketing",
    "experiments": {
      "typedRoutes": true
    }
  }
}
